[Unit]
Description=HYDRA-UMC-ANOMALY-DETECTOR real FFT + z-score anomaly-detection API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hydra-umc-anomaly
Group=hydra-umc-anomaly
WorkingDirectory=/opt/hydra-umc/anomaly-detector
Environment=PYTHONPATH=/opt/hydra-umc/anomaly-detector/src
ExecStart=/usr/bin/python3 -m hydra_umc_anomaly_detector.main --addr 127.0.0.1 --port 8097
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# C13: a real, initial cgroup memory ceiling - conservative defaults, meant to be refined once real telemetry from this service running on the CM5 exists, never removed back to unlimited.
MemoryHigh=256M
MemoryMax=384M

[Install]
WantedBy=multi-user.target
